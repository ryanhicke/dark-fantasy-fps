[node name="Level08" type="Node3D" unique_id=589703576]
script = ExtResource("1_level")
player_scene = ExtResource("2_player")
display_name = "The Great Demon"
intermission_text = "The demon falls. The cage comes down, and the portal home opens."
ending_text = "The town still smelled of ash when you carried her through the gate. The mayor wept, then stood straight and gave you the captain's sword. The forest is quiet now. For now.

Far up the Feldberg, in an empty tomb, the candles were burning again."
music = ExtResource("snd_abyss")

